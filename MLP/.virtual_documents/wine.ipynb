# import for creating MLP classifier of wine data set
import numpy as np
from sklearn.neural_network import MLPClassifier
from sklearn.datasets import load_wine
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import confusion_matrix
import matplotlib.pylab as plt


# data set of measurements of wines from 3 regions of Italy
data = load_wine()
data.feature_names


# y is the target, with values 0,1,2 corresponding to region in Italy
# X is set of measurements given
X = data.data; y = data.target
X.shape, y.shape, 


# plot the data to examine
for n in range(len(data.feature_names)):
    plt.plot(X[:,n],label=data.feature_names[n])
    plt.legend(loc='upper right')
    


# now scale data before training
scaler = StandardScaler()
scaler.fit(X)
scaler.mean_, np.sqrt(scaler.var_)


# transform data and replot
X = scaler.transform(X)
for n in range(len(data.feature_names)):
    plt.plot(X[:,n],label=data.feature_names[n])
    plt.legend(loc='upper right')


# before going on, plot out the target values
plt.plot(y)


# create and apply MLP
hiddenLayerSizes = (2)
activ = 'relu'
solv = 'lbfgs'
randomState = 1
#
mlpc = MLPClassifier( hidden_layer_sizes = hiddenLayerSizes, \
                        activation = activ, \
                        solver = solv, \
                        random_state = randomState 
                    )
mlpc.fit(X,y)


# try prediction on the training set
yp = mlpc.predict(X)
plt.plot(y); plt.plot(yp)


# evaluate with metrics
mlpcCM = confusion_matrix(y,yp)
print('\t\tpredictions')
print('\t\t{0}\t{1}\t{2}'.format(0,1,2))
for n in [0,1,2]:
    print('truth\t{3}\t{0}\t{1}\t{2}'.format(mlpcCM[n,0],mlpcCM[n,1],mlpcCM[n,2],n))






